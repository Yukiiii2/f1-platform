# Copy to apps/web/.env.local. Local application API address only.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Copy to apps/api/.env and replace DATABASE_URL placeholders for migrations.
# Do not put these values in a NEXT_PUBLIC_* variable.
DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
# Reserved for later phases; not used by the backend domain foundation.
REDIS_URL=redis://<host>:<port>/<database>

# Optional Pitwall backend configuration in apps/api/.env only.
# Set PITWALL_PROVIDER to gemini or openai; blank preserves the OpenAI default.
# Gemini development model: gemini-3.8-flash (function calling + structured JSON).
# Blank values keep AI disabled; existing data APIs continue to work.
OPENAI_API_KEY=
GEMINI_API_KEY=
PITWALL_PROVIDER=
PITWALL_MODEL=
# Optional comma-separated model IDs, in fallback order (maximum three).
# Supported examples: gemini-3.6-flash,gemini-3.8-flash; blank disables fallback.
PITWALL_FALLBACK_MODELS=
# Retries per model: 0-2; blank/unset uses one retry with exponential backoff.
PITWALL_MAX_RETRIES=
# Aggregate limits shared across API processes; use identical values on all replicas.
# Optional: unset uses 10 requests/minute, 100/day (UTC), 2 concurrent queries.
# PITWALL_REQUESTS_PER_MINUTE=<1-100>
# PITWALL_REQUESTS_PER_DAY=<1-10000>
# PITWALL_MAX_CONCURRENT=<1-8>
